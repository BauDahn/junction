      "id": "crear-sesion",
      "name": "Crear sesión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev=$('Normalizar entrada').first().json; const body=$json.body??$json; if($json.statusCode>=400) return [{json:{...prev,statusCode:$json.statusCode,error:body.error||body.message||'No se pudo crear sesión',details:body}}]; const sid=body.session_id||prev.session_id; return [{json:{...prev,session_id:sid}}];"
      },
      "id": "preparar-mensaje",
      "name": "Preparar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl + \"/api/sessions/\" + $json.session_id + \"/messages\" }}",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.question }}"
            },
            {
              "name": "context",
              "value": "={{ {journal_item_id:$json.journal_item_id} }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "retry": {
            "maxTries": 5,
            "waitBetweenTries": 2000
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "enviar-pregunta",
      "name": "Enviar pregunta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; if($json.statusCode>=400) return [{json:{statusCode:$json.statusCode,error:body.error||body.message||'Error enviando pregunta',details:body,text:'Error al consultar el backend',blocks:[],sources:[],call:[]}}]; const r=body.reply||body; return [{json:{text:r.text||'',blocks:r.blocks||[],sources:r.sources||[],call:(r.blocks||[]).map(b=>b.call).filter(Boolean)}}];"
      },
      "id": "formatear-respuesta-chat",
      "name": "Formatear respuesta chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1530,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json.body??$json; const state=$getWorkflowStaticData('global'); state[$execution.id+':journal']=1; const founders=x.edition==='founders'&&x.session_id; const base=founders?`/api/sessions/${x.session_id}/journal`:'/api/journal/ecosistema'; const regen=base+'/regenerate'; return [{json:{...x,journalUrl:x.baseUrl+base+'?date='+encodeURIComponent(x.date),regenUrl:x.baseUrl+regen,attempt:0}}];"
      },

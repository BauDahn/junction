      "typeVersion": 4.2,
      "position": [
        870,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ Number($json.statusCode ?? 0) >= 400 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "404-explicito",
      "name": "404 explícito",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; const state=$getWorkflowStaticData('global'); delete state[$execution.id+':journal']; const missing=$json.statusCode===404; return [{json:{status:missing?'unavailable':'error',statusCode:$json.statusCode,error:body.error||body.message||(missing?'Journal aún no integrado':'Error backend'),message:missing?'Los endpoints /api/journal/* responden 404 hasta que Issue #31 se integre.':'Error HTTP del backend',details:body}}];"
      },

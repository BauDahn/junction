      },
      "id": "incrementar-intento",
      "name": "Incrementar intento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2130,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j=$json.body??$json; if($json.statusCode>=400) return [{json:{status:'error',statusCode:$json.statusCode,error:j.error||j.message||'Error consultando Journal',details:j}}]; if(j.status==='generating'){const state=$getWorkflowStaticData('global'); delete state[$execution.id+':journal']; return [{json:{status:'timeout',statusCode:$json.statusCode,error:'Se agotaron los 30 intentos de polling generando el journal',edition:j.edition,date:j.date,sections:[],items:[],is_new:[],cala_tables:[],blocks:[]}}];} const sections=j.sections||[]; const items=sections.flatMap(s=>(s.items||[]).map(i=>({section:s.title,description:s.description,id:i.id,is_new:i.is_new,block:i.block}))); const blocks=items.map(i=>i.block); const state=$getWorkflowStaticData('global'); delete state[$execution.id+':journal']; return [{json:{edition:j.edition,date:j.date,status:j.status,sections,items,is_new:items.filter(i=>i.is_new),cala_tables:blocks.filter(b=>b?.type==='cala_table').map(b=>({title:b.title,columns:b.columns,rows:b.rows,focus_rows:b.focus_rows,answer:b.answer,sources:b.sources,call:b.call})),blocks}}];"
      },

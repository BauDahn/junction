    {
      "parameters": {
        "jsCode": "const b=$json.body??$json; return [{json:{...b,baseUrl:$env.JUNCTION_API_URL||'http://localhost:8000',date:b.date||new Date().toISOString().slice(0,10),edition:b.edition||'ecosistema',attempt:0}}];"
      },
      "id": "normalizar-entrada",

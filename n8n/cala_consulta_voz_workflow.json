    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; if($json.statusCode>=400) return [{json:{statusCode:$json.statusCode,error:body.error||body.message||'Error consultando Cala',details:body,text:'Error al consultar el backend',blocks:[],sources:[],call:[]}}]; const r=body.reply||body; const blocks=r.blocks||[]; const formatted=blocks.map(b=>{if(b.type==='cala_table')return {...b,display_rows:(b.focus_rows?.length?b.focus_rows.map(i=>b.rows?.[i]):b.rows),display_answer:b.answer||null}; return b;}); return [{json:{text:r.text||'',blocks:formatted,sources:r.sources||formatted.flatMap(b=>b.sources||[]),call:formatted.flatMap(b=>b.call?[b.call]:[])}}];"
      },

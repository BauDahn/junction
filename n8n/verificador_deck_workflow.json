    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; if(Number($json.statusCode??0)>=400 || !body.job_id) return [{json:{...body,status:'error',statusCode:$json.statusCode,error:body.error||body.message||'No se pudo crear el job'}}]; const state=$getWorkflowStaticData('global'); state[$execution.id+':deck']=1; const prev=$('Preparar job').first().json; return [{json:{...prev,...body,job_id:body.job_id,attempt:0,statusCode:$json.statusCode}}];"
      },

      "id": "error",
      "name": "¿Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; const state=$getWorkflowStaticData('global'); delete state[$execution.id+':deck']; const timedOut=Number($json.attempt??0)>=60 && body.status!=='error'; return [{json:{status:body.status||'error',statusCode:$json.statusCode,error:body.error||body.message||(timedOut?'Se agotaron los 60 intentos de polling':'Job en estado error'),details:body}}];"
      },
      "id": "reporte-error",
      "name": "Reporte error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body??$json; if($json.statusCode>=400) return [{json:{status:'error',statusCode:$json.statusCode,error:body.error||body.message||'Error consultando job',details:body}}]; const r=body.report||{}; const claims=(r.claims||[]).filter(c=>['contradicted','partially_confirmed'].includes(c.verdict)); const md=[`# Verificación: ${r.startup_name||'Deck'}`,`- Proveedor: ${r.provider||'\\u2014'} (${r.model||'\\u2014'})`,`- Trust score: ${r.trust_score??'\\u2014'}`,`- Resumen: ${JSON.stringify(r.summary||{})}`,'## Afirmaciones a revisar',...claims.map(c=>`### ${c.verdict}: ${c.quote||''}\\n\\n${c.explanation||''}\\n\\nEvidencia: ${JSON.stringify(c.evidence||'')}\\n\\nFuentes: ${JSON.stringify(c.sources||[])}\\n\\nPregunta Cala: ${c.cala_question||''}`)].join('\\n\\n'); const state=$getWorkflowStaticData('global'); delete state[$execution.id+':deck']; return [{json:{status:body.status,startup_name:r.startup_name,provider:r.provider,model:r.model,trust_score:r.trust_score,summary:r.summary,claims,markdown:md,alert:(Number(r.trust_score)<70||claims.some(c=>c.verdict==='contradicted'))}}];"
      },

          "conditions": [
            {
              "leftValue": "={{ $json.status === \"error\" || Number($json.statusCode ?? 0) >= 400 || (Number($json.attempt ?? 0) >= 60 && $json.status !== \"done\") }}",
              "rightValue": true,

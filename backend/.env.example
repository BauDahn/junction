# Claves (copiá este archivo a .env y completalo; .env nunca se sube)
CALA_API_KEY=
NVIDIA_API_KEY=
# Opcional: modelo de NVIDIA (respaldo configurable)
NVIDIA_MODEL=
# Transcripción: whisper (si faster-whisper está instalado) o none por defecto
# TRANSCRIPTION_PROVIDER=whisper
# Modelo local faster-whisper (por defecto: small)
# WHISPER_MODEL=small
# Modelo NVIDIA ASR (por defecto: nvidia/parakeet-ctc-1.1b-asr)
# NVIDIA_ASR_MODEL=nvidia/parakeet-ctc-1.1b-asr

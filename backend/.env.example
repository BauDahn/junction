# Keys (copy this file to .env and fill it in; .env is never committed)
CALA_API_KEY=
NVIDIA_API_KEY=
# Gemini (GOOGLE_API_KEY is also accepted)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Opcional: modelo de NVIDIA (respaldo configurable)
NVIDIA_MODEL=nemotron-3.5-super-vl
NVIDIA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1

# CORS allowed origins, comma-separated (default "*", development only)
# CORS_ORIGINS=http://localhost:8081

# Transcription: gemini if GEMINI_API_KEY is set; otherwise whisper if installed; otherwise none
# TRANSCRIPTION_PROVIDER=gemini|whisper|nvidia|none
# Audio-only model (defaults to GEMINI_FAST_MODEL); must support system instructions and JSON output.
# gemini-3.5-transcribe no admite esas funciones.
# GEMINI_TRANSCRIBE_MODEL=gemini-flash-latest
# Modelo local faster-whisper (por defecto: small)
# WHISPER_MODEL=small
# Modelo NVIDIA ASR (por defecto: nvidia/parakeet-ctc-1.1b-asr)
# NVIDIA_ASR_MODEL=nvidia/parakeet-ctc-1.1b-asr

# Shared cache in Aiven Valkey (optional; without this, cache is local to disk). See canonizador/README.md
# VALKEY_URL=rediss://default:<password>@<host>:<port>
# CACHE_TTL_S=604800
# ACCOUNTS_STORE=valkey
# CALA_REQUIRE_AUTH=0
# CALA_DAILY_CALL_CAP=2000
# ADMIN_TOKEN=
